# 环境变量配置（本地模式）
# 复制此文件为 .env 并填写实际值（如有需要）

# Ollama 本地 LLM 服务地址（默认即可）
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# 引擎选择（可选覆盖，默认读 config.yaml）
# IMAGE_PROVIDER=comfyui
# VIDEO_PROVIDER=comfyui
# LLM_PROVIDER=ollama

# ComfyUI 本地服务（默认即可）
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8189

# ComfyUI 输出目录（视频/图片生成结果存放处，默认即可）
COMFY_OUTPUT_DIR=/Users/a715/git/ComfyUI/ComfyUI-Installs/ComfyUI/ComfyUI/output

# 创作笔记存放目录（每次创作完成后自动生成 Markdown 笔记）
# 指向 Obsidian 库时，笔记会直接写入该库；留空则回落项目内 storage/notes/
# 例：OBSIDIAN_VAULT=/Users/you/Documents/Obsidian/我的笔记库
# OBSIDIAN_VAULT=

